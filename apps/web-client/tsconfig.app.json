{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "module": "preserve",
        "moduleResolution": "bundler",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["*"]
        },
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": ["src"]
}
