{
    "name": "@nmm/api-server",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "db:generate": "node --env-file=.env ../../node_modules/.bin/pgtyped -c pgtyped.config.json",
        "db:verify": "node scripts/run-sqldef-verify.mjs",
        "dev:docker": "nest start --watch",
        "test": "node --test -r ts-node/register -r tsconfig-paths/register test/*.spec.ts",
        "start:prod": "node dist/main",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@nestjs-cls/transactional": "^3.2.1",
        "@nestjs/common": "^11.1.9",
        "@nestjs/core": "^11.1.9",
        "@nestjs/platform-express": "^11.1.9",
        "@nmm/shared": "file:../../packages/shared",
        "@pgtyped/runtime": "^2.4.2",
        "better-auth": "^1.6.19",
        "dotenv": "^17.2.3",
        "nestjs-cls": "^6.2.1",
        "nestjs-pino": "^4.4.1",
        "pg": "^8.16.3",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.12",
        "@nestjs/schematics": "^11.0.9",
        "@pgtyped/cli": "^2.4.3",
        "@types/express": "^5.0.5",
        "@types/node": "^24.10.1",
        "@types/pg": "^8.20.0",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
